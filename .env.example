# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI (opcional: se envía como fallback a las Edge Functions)
# Si está configurada como variable de entorno en Supabase Edge Functions,
# esta variable no es necesaria. Solo úsala para desarrollo local.
VITE_OPENAI_API_KEY=sk-your-openai-key-here

# NOTA: La service role key NUNCA debe ir en el frontend.
# Solo se usa en Supabase Edge Functions como variable de entorno.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
